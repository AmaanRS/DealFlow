NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://mongodb:27017/dealflow
PUBLIC_APP_URL=http://localhost:9080
ALLOWED_ORIGINS=http://localhost:9080,http://127.0.0.1:9080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Generate a strong, unique value before starting the service.
SESSION_PEPPER=local-only-change-this-session-pepper

OTEL_SERVICE_NAME=dealflow-api-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_METRIC_EXPORT_INTERVAL=60000
