NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://mongodb:27017/dealflow
PUBLIC_APP_URL=http://localhost:9080
ALLOWED_ORIGINS=http://localhost:9080,http://127.0.0.1:9080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Generate a strong, unique value before starting the service.
SESSION_PEPPER=local-only-change-this-session-pepper
MORNING_STAR_URL=http://morning_star:3002
NIGHT_SKY_URL=http://night_sky:3001

# Gmail SMTP: use a Google App Password, never your normal Google password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your-account@gmail.com
MAIL_APP_PASSWORD=replace-with-google-app-password
MAIL_FROM=DealFlow360 <your-account@gmail.com>

OTEL_SERVICE_NAME=dealflow-api-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_METRIC_EXPORT_INTERVAL=60000
